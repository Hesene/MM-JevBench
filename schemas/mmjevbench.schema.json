{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmjevbench.org/schema/v1.0.0",
  "title": "MM-JevBench canonical decision record",
  "type": "object",
  "required": [
    "id", "schema_version", "track", "task_type", "domain", "language",
    "modalities", "state", "candidates", "gold", "group_id", "split",
    "source", "sampling", "annotations", "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "track": {"enum": [
      "academic_cmmmu", "exam_multi", "gui_action_type",
      "general_mmbench", "culture_ccbench"
    ]},
    "task_type": {"enum": ["choice", "noul", "score"]},
    "domain": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "modalities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["text", "image", "audio", "video", "ocr"]}
    },
    "state": {
      "type": "object",
      "required": ["context", "question", "media", "history"],
      "properties": {
        "context": {"type": "string"},
        "question": {"type": "string", "minLength": 1},
        "media": {
          "type": "object",
          "properties": {
            "image": {"type": "array", "items": {"type": "string"}},
            "audio": {"type": "array", "items": {"type": "string"}},
            "video": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "history": {"type": "array"}
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["key", "text", "value"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "gold": {
      "type": "object",
      "required": ["label_index", "label_key", "outcome_distribution", "provenance"],
      "properties": {
        "label_index": {"type": "integer", "minimum": 0},
        "label_key": {"type": "string", "minLength": 1},
        "outcome_distribution": {
          "type": "array", "minItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "provenance": {"enum": ["source_gold", "adjudicated", "human_votes", "derived"]}
      },
      "additionalProperties": false
    },
    "group_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["unassigned", "dev", "test"]},
    "source": {
      "type": "object",
      "required": ["dataset", "source_id", "version"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sampling": {
      "type": "object",
      "properties": {
        "stratum": {"type": "string"},
        "frame_size": {"type": "integer", "minimum": 1},
        "quota": {"type": "integer", "minimum": 1},
        "inclusion_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "analysis_weight": {"type": "number", "minimum": 1},
        "priority": {"type": "string"}
      },
      "additionalProperties": true
    },
    "annotations": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

